{
    "name": "picord",
    "version": "0.30.1",
    "description": "A self-hosted, Discord-style personal Agent runtime built on Pi",
    "keywords": [
        "pi",
        "discord",
        "channels",
        "ai",
        "agent",
        "coding-agent",
        "mobile",
        "multiplayer",
        "durable"
    ],
    "type": "module",
    "license": "MIT",
    "author": "Tanner Middleton",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Feng-H/picord.git"
    },
    "homepage": "https://github.com/Feng-H/picord#readme",
    "bugs": {
        "url": "https://github.com/Feng-H/picord/issues"
    },
    "bin": {
        "picord": "bin/picord.js",
        "pi-pocket": "bin/picord.js"
    },
    "files": [
        "bin/",
        "src/",
        "web/",
        "types/",
        "docs/",
        "contrib/",
        "AGENTS.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "npm-shrinkwrap.json"
    ],
    "engines": {
        "node": ">=22.19"
    },
    "scripts": {
        "start": "node bin/picord.js",
        "dev": "node bin/picord.js --cwd .",
        "check": "tsc --noEmit -p . && node test/types-file.ts && node docs-site/check-reference.mjs",
        "check:sandbox": "instabox run --push . --timeout 5m -- 'npm ci && npm run check && npm run lint'",
        "test": "node --test --test-concurrency=4 --test-timeout=600000 test/*.test.ts",
        "test:server": "node -e \"const {spawnSync}=require('node:child_process'),{readdirSync}=require('node:fs');const files=readdirSync('test').filter(f=>f.endsWith('.test.ts')).sort().map(f=>'test/'+f);const env={...process.env,PI_POCKET_BROWSER:'/nonexistent'};if(process.platform!=='win32'&&env.TMPDIR?.includes('/.')){env.TMPDIR='/tmp';}const r=spawnSync(process.execPath,['--test','--test-force-exit','--test-concurrency=2','--test-timeout=120000',...files],{stdio:'inherit',env});process.exit(r.status??1);\"",
        "site:publish": "gh workflow run pages.yml",
        "format": "eslint --fix . && prettier --write .",
        "format:check": "prettier --check . && eslint .",
        "lint": "eslint .",
        "prepack": "node -e \"require('node:fs').copyFileSync('package-lock.json', 'npm-shrinkwrap.json')\"",
        "postpack": "node -e \"require('node:fs').rmSync('npm-shrinkwrap.json', { force: true })\"",
        "prepublishOnly": "npm run check && npm run lint && npm test"
    },
    "dependencies": {
        "@earendil-works/chord": "1.6.0",
        "@earendil-works/pi-ai": "1.6.0",
        "@earendil-works/pi-codemode": "1.6.0",
        "@earendil-works/pi-coding-agent": "1.6.0",
        "@earendil-works/pi-durable": "1.6.0",
        "@earendil-works/pi-mcp": "1.6.0",
        "@earendil-works/pi-schema": "1.6.0",
        "dompurify": "^3.4.17",
        "heic-convert": "^2.1.0",
        "htm": "^3.1.1",
        "jiti": "2.7.0",
        "katex": "^0.19.1",
        "marked": "^18.1.1",
        "minimatch": "10.2.6",
        "pele": "^1.13.0",
        "preact": "^11.0.2",
        "qrcode": "^1.5.4",
        "typebox": "1.3.27",
        "undici": "8.12.4"
    },
    "overrides": {
        "undici": "$undici"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "^26.6.5",
        "@types/qrcode": "^1.5.6",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1"
    }
}
